---
import { sourceIds, sourceLabels } from '../../content/schemas/knowledge.ts';
import type { EditorialDocument } from '../../utils/source-blocks.ts';
import { formatDate, persianNumber } from '../../utils/content-presentation.ts';
import DocumentStatus from './DocumentStatus.astro';
import HubIcon from '../common/HubIcon.astro';
interface Props {
  document: EditorialDocument;
}
const { document } = Astro.props;
const sourceNames = sourceIds.flatMap((id) => {
  const material = document.sources[id];
  if (!material) return [];
  const available = [
    material.recordings.some(({ kind }) => kind === 'video') && 'ویدیو',
    material.recordings.some(({ kind }) => kind === 'audio') && 'صوت',
    material.repository && 'کد',
    material.references.length > 0 && 'مرجع',
  ].filter(Boolean);
  return [`${sourceLabels[id]}${available.length ? ` (${available.join('، ')})` : ''}`];
});
---

<div class="kb-document-meta" data-pagefind-ignore>
  <DocumentStatus status={document.status} />
  {document.type !== 'concept' && (
    <span>
      <HubIcon name="book" />
      جلسهٔ {persianNumber(document.sessionNumber)}
    </span>
  )}
  <span>
    <HubIcon name="calendar" />
    آخرین به‌روزرسانی: <time datetime={document.updatedAt}>{formatDate(document.updatedAt)}</time>
  </span>
  <span>
    <HubIcon name="sources" />
    {sourceNames.length
      ? `منابع${document.demo ? ' نمایشی' : ''}: ${sourceNames.join('، ')}`
      : 'منبع کلاس ثبت نشده'}
  </span>
</div>
